<rml>
<head>
	<title>Menu</title>
	<link type="text/rcss" href="menu.rcss"/>
</head>
<body>
	<div id="shade"></div>
	<!-- one column, top to bottom, each part in its own space: nothing can overlap -->
	<div id="panel">
		<div id="title">PAUSED</div>
		<div id="crumb"></div>
		<div id="rows"></div>
		<div id="note"></div>
		<div id="hint">
			<span class="key">Arrows</span> / <span class="key">D-pad</span> choose
			&nbsp;&nbsp;<span class="key">Left Right</span> change
			&nbsp;&nbsp;<span class="key">Enter</span> / <span class="key">A</span> select
			&nbsp;&nbsp;<span class="key">Esc</span> / <span class="key">B</span> back
		</div>
		<div id="ver"></div>
	</div>
</body>
</rml>
