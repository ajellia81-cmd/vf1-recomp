// Keep the iOS target interpreter-only. Never remove this without an iOS distribution review.
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) VF1_IOS=1 VF1_DISABLE_JIT=1 VF_GPU3D_METAL=1 RMLUI_STATIC_LIB=1 RMLUI_FONT_ENGINE_FREETYPE=1 RMLUI_SDL_VERSION_MAJOR=3
CLANG_CXX_LANGUAGE_STANDARD = c++20
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/Generated $(SRCROOT)/../third_party/glm $(SRCROOT)/../third_party/musashi $(SRCROOT)/../build/musashi $(SRCROOT)/../src/core/shim_include $(SRCROOT)/../third_party/rmlui/Include $(SRCROOT)/../third_party/rmlui/Backends
OTHER_CPLUSPLUSFLAGS = $(inherited) -DVF1_IOS=1 -DVF1_DISABLE_JIT=1
OTHER_LDFLAGS = $(inherited) -lz
CLANG_ENABLE_OBJC_ARC = YES
ENABLE_BITCODE = NO
ARCHS = arm64
IPHONEOS_DEPLOYMENT_TARGET = 15.0
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// These identifiers are emitted by xcodebuild -create-xcframework for the arm64 slices.
HEADER_SEARCH_PATHS[sdk=iphoneos*] = $(inherited) $(SRCROOT)/Dependencies/SDL3.xcframework/ios-arm64/Headers $(SRCROOT)/Dependencies/FreeType.xcframework/ios-arm64/Headers
HEADER_SEARCH_PATHS[sdk=iphonesimulator*] = $(inherited) $(SRCROOT)/Dependencies/SDL3.xcframework/ios-arm64-simulator/Headers $(SRCROOT)/Dependencies/FreeType.xcframework/ios-arm64-simulator/Headers
